# Postgres — use the pooled connection string
DATABASE_URL=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_STATUS_WEBHOOK_SECRET=
FROM_EMAIL="Qwen <coach@example.com>"
REPLY_TO_EMAIL=coach@example.com

# Generation — all model calls go through OpenRouter.
# Slugs look like "vendor/model-name"; browse https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional: a different model per job. Falls back to OPENROUTER_MODEL.
#   writer  — the daily coaching email (the one whose voice you tune)
#   profile — folds each reply into the durable profile
#   planner — the weekly forward plan
OPENROUTER_MODEL_WRITER=
OPENROUTER_MODEL_PROFILE=
OPENROUTER_MODEL_PLANNER=

# Optional: comma-separated fallbacks OpenRouter tries when the primary is
# rate-limited or down. Per-job variants also work, e.g.
# OPENROUTER_MODEL_WRITER_FALLBACKS.
OPENROUTER_MODEL_FALLBACKS=

# Optional: extra slugs offered in the admin preview picker, for comparing
# models on a real subscriber's history before switching.
OPENROUTER_PREVIEW_MODELS=

# Cron auth (Vercel sends this automatically in production)
CRON_SECRET=

# Admin — also the session cookie signing key
ADMIN_PASSWORD=

NEXT_PUBLIC_APP_URL=http://localhost:3000
